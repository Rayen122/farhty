# ─────────────────────────────────────────────────────────────
#  Base de données — copie ce fichier en `.env.local` et remplis
#  `.env.local` n'est jamais commité (voir .gitignore)
# ─────────────────────────────────────────────────────────────

# Neon (recommandé) — Dashboard Neon > Connection string > "Pooled connection"
# Sans cette variable, les invitations sont écrites dans .data/invitations.json,
# ce qui ne survit PAS à un déploiement Vercel.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Supabase (alternative) — utilisé seulement si DATABASE_URL est absent
# NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbG..."

# ─────────────────────────────────────────────────────────────
#  Paiement (D17 manuel, en attendant l'API marchand La Poste)
# ─────────────────────────────────────────────────────────────

# Numéro D17 affiché au client sur la page de paiement
NEXT_PUBLIC_D17_NUMBER="XXXXXXXX"

# Jeton de validation des paiements. Sans lui, /api/admin/payments est
# désactivée (401) plutôt que laissée ouverte. Génère-le avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FARHTY_ADMIN_TOKEN=""
